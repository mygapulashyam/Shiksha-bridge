NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/shiksha_bridge
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_different_from_main_secret
JWT_REFRESH_EXPIRE=30d
CORS_ORIGIN=http://localhost:3000

# AI Features (NVIDIA NIM - meta/llama-3.1-70b-instruct)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@shiksha.edu
EMAIL_FROM_NAME=ShikshaBridge Security

# Security
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30
